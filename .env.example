# Same Postgres as apira docker-compose.local.yml.
DATABASE_URL=postgresql+psycopg2://apira:apira@host.docker.internal:5432/apira
GOOGLE_API_KEY=your_gemini_api_key_here

# Backend REST (login / holdings / recommendation tools)
USER_SERVICE_URL=http://host.docker.internal:8001
PORTFOLIO_SERVICE_URL=http://host.docker.internal:8002

# Optional overrides
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=768
# EMBED_DELAY_SECONDS=0.7

# Structured logging
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=development
